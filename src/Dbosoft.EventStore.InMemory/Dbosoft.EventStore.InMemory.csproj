<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Dbosoft.EventStore.InMemory</RootNamespace>
    <Description>In-memory reference provider for the Dbosoft event store, implementing every capability.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- References Core (not just Abstractions) so the provider can add a UseInMemory() method to
         the EventStoreBuilder, keeping registration a single fluent chain. -->
    <ProjectReference Include="..\Dbosoft.EventStore\Dbosoft.EventStore.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
