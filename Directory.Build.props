<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing-doc (CS1591) stays a warning: the public surface is documented, but trivial
         members (operators, obvious constructors, enum None) are not forced. Malformed or
         dangling doc references (CS1574 etc.) remain errors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>dbosoft GmbH</Authors>
    <Company>dbosoft GmbH</Company>
    <Product>Dbosoft.EventStore</Product>
    <PackageProjectUrl>https://github.com/dbosoft/dotnet-eventstore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dbosoft/dotnet-eventstore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <!-- The package version is supplied by GitVersion in CI (see azure-pipelines.yml); a local pack
         falls back to the SDK default. Only IsPackable projects produce packages. -->
    <!-- Source Link: publish the commit-pinned repository URL and embed untracked sources into the PDB,
         so consumers can step into the exact source. SDK-provided on net8+, no extra package needed. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Ship the PDB inside the package so symbols travel with it. -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <!-- Deterministic, path-normalized build on the CI agent (Azure Pipelines sets TF_BUILD). -->
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
